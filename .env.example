# Copy to .env (local) or add as Environment Variables (Hostinger). Never commit .env.
PORT=8080

# Admin login: username (email) + password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string that signs admin sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MySQL / MariaDB. On Hostinger use 127.0.0.1 (NOT localhost) and the full prefixed names, e.g. u123456789_nirvana.
# Leave DB_HOST empty to use the local JSON file (data/db.json) instead.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Or one connection string instead of the five above:
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/database
