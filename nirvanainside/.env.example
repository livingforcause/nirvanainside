# Copy to .env and fill in. Never commit .env.
PORT=8080
# Admin login: username (email) + password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string that signs admin sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
